Hfin_account_dbt/target/run/fin_account_dbt/models/silver/slv_account.sql¦-- back compat for old kwarg name
  
  begin;
    
        
            
                
                
            
                
                
            
        
    

    

    merge into FIN_DB.SILVER.slv_account as DBT_INTERNAL_DEST
        using FIN_DB.SILVER.slv_account__dbt_tmp as DBT_INTERNAL_SOURCE
        on (
                    DBT_INTERNAL_SOURCE.slsfrc_id = DBT_INTERNAL_DEST.slsfrc_id
                ) and (
                    DBT_INTERNAL_SOURCE.efective_dt = DBT_INTERNAL_DEST.efective_dt
                )

    
    when matched then update set
        "SLSFRC_ID" = DBT_INTERNAL_SOURCE."SLSFRC_ID","EFECTIVE_DT" = DBT_INTERNAL_SOURCE."EFECTIVE_DT","ACCOUNT_NAME" = DBT_INTERNAL_SOURCE."ACCOUNT_NAME","ACCOUNT_TYPE" = DBT_INTERNAL_SOURCE."ACCOUNT_TYPE","INDUSTRY" = DBT_INTERNAL_SOURCE."INDUSTRY","ANNUAL_REVENUE" = DBT_INTERNAL_SOURCE."ANNUAL_REVENUE","ACCOUNT_STATUS" = DBT_INTERNAL_SOURCE."ACCOUNT_STATUS","BILLING_STATE" = DBT_INTERNAL_SOURCE."BILLING_STATE","ROW_HASH" = DBT_INTERNAL_SOURCE."ROW_HASH","INGESTED_TS" = DBT_INTERNAL_SOURCE."INGESTED_TS","DBT_INSERTED_TS" = DBT_INTERNAL_SOURCE."DBT_INSERTED_TS"
    

    when not matched then insert
        ("SLSFRC_ID", "EFECTIVE_DT", "ACCOUNT_NAME", "ACCOUNT_TYPE", "INDUSTRY", "ANNUAL_REVENUE", "ACCOUNT_STATUS", "BILLING_STATE", "ROW_HASH", "INGESTED_TS", "DBT_INSERTED_TS")
    values
        ("SLSFRC_ID", "EFECTIVE_DT", "ACCOUNT_NAME", "ACCOUNT_TYPE", "INDUSTRY", "ANNUAL_REVENUE", "ACCOUNT_STATUS", "BILLING_STATE", "ROW_HASH", "INGESTED_TS", "DBT_INSERTED_TS")

;
    commit;*
