É
Mfin_account_dbt/target/compiled/fin_account_dbt/models/silver/slv_account.sqlË



with  __dbt__cte__stg_account as (


select
    trim(slsfrc_id)               as slsfrc_id,
    efective_dt,
    trim(account_name)            as account_name,
    initcap(trim(account_type))   as account_type,
    trim(industry)                as industry,
    annual_revenue,
    initcap(trim(account_status)) as account_status,
    upper(trim(billing_state))    as billing_state,
    md5(concat_ws('|', coalesce(account_name::varchar, '~'), coalesce(account_type::varchar, '~'), coalesce(industry::varchar, '~'), coalesce(annual_revenue::varchar, '~'), coalesce(account_status::varchar, '~'), coalesce(billing_state::varchar, '~')
    ))                            as row_hash,
    ingested_ts
from FIN_DB.RAW.VW_ACCOUNT_SRC
where slsfrc_id is not null and efective_dt is not null
-- one row per natural key; latest ingestion wins on reloads
qualify row_number() over (partition by slsfrc_id, efective_dt order by ingested_ts desc) = 1
), src as (
    -- CDC filter: only rows ingested since the last load
    select slsfrc_id, efective_dt, account_name, account_type, industry, annual_revenue, account_status, billing_state, row_hash, ingested_ts, 'SRC' as rec_src
    from __dbt__cte__stg_account
    
    where ingested_ts > (select coalesce(max(ingested_ts), '1900-01-01'::timestamp_ntz) from FIN_DB.SILVER.slv_account)
    
)


, tgt_latest as (
    -- latest Silver row per affected account = comparison baseline
    select slsfrc_id, efective_dt, account_name, account_type, industry, annual_revenue, account_status, billing_state, row_hash, ingested_ts, 'TGT' as rec_src
    from FIN_DB.SILVER.slv_account
    where slsfrc_id in (select slsfrc_id from src)
    qualify row_number() over (partition by slsfrc_id order by efective_dt desc) = 1
)


, unioned as (
    select * from src
    
    union all
    select * from tgt_latest
    
)

, deduped as (
    -- a key present in both (reload) keeps the existing Silver row
    select * from unioned
    qualify row_number() over (
        partition by slsfrc_id, efective_dt order by iff(rec_src = 'TGT', 0, 1)
    ) = 1
)

, compared as (
    select *, lag(row_hash) over (partition by slsfrc_id order by efective_dt) as prev_hash
    from deduped
)

select
    slsfrc_id, efective_dt, account_name, account_type, industry,
    annual_revenue, account_status, billing_state, row_hash, ingested_ts,
    current_timestamp()::timestamp_ntz as dbt_inserted_ts
from compared
where rec_src = 'SRC'
  and (prev_hash is null or row_hash <> prev_hash)*
