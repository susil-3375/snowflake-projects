ffin_account_dbt/target/run/fin_account_dbt/models/silver/schema.yml/not_null_slv_account_slsfrc_id.sqlóselect
      count(*) as failures,
      count(*) != 0 as should_warn,
      count(*) != 0 as should_error
    from (
      
    
    



select slsfrc_id
from FIN_DB.SILVER.slv_account
where slsfrc_id is null



      
